<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Name="StartupRoot"
    x:Class="Remvora.App.Pages.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Remvora.App.ViewModels"
    mc:Ignorable="d">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical" Spacing="4">
                <TextBlock Text="Startup Manager" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
                <TextBlock Text="Control programs that launch automatically with Windows to optimize boot speed and resource usage." Style="{ThemeResource BodySubtleTextBlockStyle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Command="{x:Bind ViewModel.RefreshCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Filter Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search -->
            <TextBox
                PlaceholderText="Search startup entries..."
                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            </TextBox>

            <!-- Category Filter Tabs -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0">
                <RadioButtons SelectedItem="{x:Bind ViewModel.SelectedFilter, Mode=TwoWay}" MaxColumns="6">
                    <x:String>All</x:String>
                    <x:String>Enabled</x:String>
                    <x:String>Disabled</x:String>
                    <x:String>Registry</x:String>
                    <x:String>Folder</x:String>
                    <x:String>High Impact</x:String>
                </RadioButtons>
            </StackPanel>

            <!-- Stats Badges -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="6" Padding="10,4">
                    <TextBlock Text="{x:Bind ViewModel.EnabledCountText, Mode=OneWay}" Foreground="White" FontWeight="SemiBold"/>
                </Border>
                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10,4">
                    <TextBlock Text="{x:Bind ViewModel.HighImpactCountText, Mode=OneWay}" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Startup Items List -->
        <Border
            Grid.Row="2"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <ListView
                ItemsSource="{x:Bind ViewModel.FilteredEntries, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:StartupItemViewModel">
                        <Grid Padding="12,10" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Toggle Enabled / Disabled" Command="{Binding ElementName=StartupRoot, Path=ViewModel.ToggleEnabledCommand}" CommandParameter="{x:Bind}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE768;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Remove from Startup" Command="{Binding ElementName=StartupRoot, Path=ViewModel.RemoveEntryCommand}" CommandParameter="{x:Bind}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <!-- Toggle Switch -->
                            <ToggleSwitch
                                IsOn="{x:Bind IsEnabled, Mode=OneWay}"
                                Toggled="OnToggleSwitchToggled"
                                Tag="{x:Bind}"
                                OnContent="" OffContent=""
                                VerticalAlignment="Center"
                                MinWidth="0"/>

                            <!-- Name & Publisher & Command -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Publisher}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="•" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Text="{x:Bind Command}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Location Badge -->
                            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind LocationDescription}" Style="{ThemeResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                            </Border>

                            <!-- Impact Badge -->
                            <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ImpactDescription}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="Medium"/>
                            </Border>

                            <!-- Action Delete Button -->
                            <Button
                                Grid.Column="4"
                                Command="{Binding ElementName=StartupRoot, Path=ViewModel.RemoveEntryCommand}"
                                CommandParameter="{x:Bind}"
                                Padding="8,6"
                                VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Status Bar -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>
    </Grid>
</Page>
