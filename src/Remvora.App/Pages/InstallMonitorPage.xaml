<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Remvora.App.Pages.InstallMonitorPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:monitor="using:Remvora.Core.Domain.Monitoring"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid Padding="24" RowDefinitions="Auto,Auto,Auto,*">
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="4">
            <TextBlock
                FontWeight="SemiBold"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="Installation Monitor" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource BodyTextBlockStyle}"
                Text="Snapshot and record system modifications made by software installers for 100% evidence-based uninstallation." />
        </StackPanel>

        <!-- Status InfoBar -->
        <InfoBar
            Grid.Row="1"
            Margin="0,0,0,16"
            IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" />

        <!-- Top Session Control Panel (Switch between New Session Form and Active Recording HUD) -->
        <Border
            Grid.Row="2"
            Margin="0,0,0,16"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <!-- Form when Idle -->
                <Grid ColumnDefinitions="*,*,Auto" Visibility="{x:Bind ViewModel.IsMonitoringActive, Mode=OneWay, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                    <TextBox
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        Height="36"
                        VerticalContentAlignment="Center"
                        PlaceholderText="Application or session name (e.g. VSCode, Notepad++)"
                        Text="{x:Bind ViewModel.NewSessionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Grid.Column="1" Margin="0,0,8,0" ColumnDefinitions="*,Auto">
                        <TextBox
                            Grid.Column="0"
                            Height="36"
                            VerticalContentAlignment="Center"
                            IsReadOnly="True"
                            PlaceholderText="Installer executable path (optional)"
                            Text="{x:Bind ViewModel.SelectedInstallerPath, Mode=OneWay}" />
                        <Button
                            Grid.Column="1"
                            Height="36"
                            Margin="4,0,0,0"
                            Click="BrowseInstaller_Click"
                            Content="Browse..." />
                    </Grid>

                    <Button
                        Grid.Column="2"
                        Command="{x:Bind ViewModel.StartMonitoringCommand}"
                        Content="Start Recording"
                        Style="{ThemeResource AccentButtonStyle}">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Enter" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </Grid>

                <!-- Active Recording HUD -->
                <Grid ColumnDefinitions="Auto,*,Auto" Visibility="{x:Bind ViewModel.IsMonitoringActive, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border
                        Grid.Column="0"
                        Width="40"
                        Height="40"
                        Margin="0,0,12,0"
                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                        CornerRadius="20">
                        <FontIcon
                            FontSize="18"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Glyph="&#xE71A;" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                FontWeight="Bold"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="MONITORING ACTIVE:" />
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.ActiveSession.SessionName, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="Installer is running. Once setup has completed, click 'Stop &amp; Save Log' below to capture changes." />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        Command="{x:Bind ViewModel.StopMonitoringCommand}"
                        Content="Stop &amp; Save Log"
                        Style="{ThemeResource AccentButtonStyle}" />
                </Grid>
            </Grid>
        </Border>

        <!-- Main Body: Saved Logs List & Detailed Change Inspector -->
        <Grid Grid.Row="3" ColumnDefinitions="360,*">
            <!-- Left: Saved Sessions List -->
            <Border
                Grid.Column="0"
                Margin="0,0,12,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" Padding="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" ColumnDefinitions="*,Auto">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="Saved Installation Logs" />
                        <Button
                            Grid.Column="1"
                            Command="{x:Bind ViewModel.LoadSessionsCommand}"
                            ToolTipService.ToolTip="Refresh Sessions">
                            <FontIcon FontSize="12" Glyph="&#xE72C;" />
                        </Button>
                    </Grid>

                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.SavedSessions, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedSavedSession, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="monitor:InstallationSession">
                                <Grid Padding="6,8" ColumnDefinitions="Auto,*,Auto">
                                    <FontIcon
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        FontSize="18"
                                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                        Glyph="&#xE9D9;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind SessionName}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind FormattedDate}" />
                                    </StackPanel>
                                    <Border
                                        Grid.Column="2"
                                        Padding="6,2"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                        CornerRadius="4">
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Text="{x:Bind TotalChangesCount}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Right: Change Inspector -->
            <Border
                Grid.Column="1"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowDefinitions="Auto,Auto,*">
                    <!-- Session Header & Delete Button -->
                    <Grid Grid.Row="0" Margin="0,0,0,16" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock
                                FontWeight="SemiBold"
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.SelectedSavedSession.SessionName, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.SelectedSavedSession.FormattedDate, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Command="{x:Bind ViewModel.DeleteSessionCommand}"
                            CommandParameter="{x:Bind ViewModel.SelectedSavedSession, Mode=OneWay}"
                            ToolTipService.ToolTip="Delete this installation log">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xE74D;" />
                                <TextBlock Text="Delete Log" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Stat Metric Badges -->
                    <Grid Grid.Row="1" Margin="0,0,0,16" ColumnDefinitions="*,*,*">
                        <Border
                            Grid.Column="0"
                            Margin="0,0,4,0"
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="6">
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" Text="Files Created" />
                                <TextBlock FontWeight="Bold" Style="{ThemeResource TitleMediumTextBlockStyle}" Text="{x:Bind ViewModel.SelectedSavedSession.CreatedFiles.Count, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Margin="4,0,4,0"
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="6">
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" Text="Registry Keys" />
                                <TextBlock FontWeight="Bold" Style="{ThemeResource TitleMediumTextBlockStyle}" Text="{x:Bind ViewModel.SelectedSavedSession.CreatedRegistryKeys.Count, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="2"
                            Margin="4,0,0,0"
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="6">
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" Text="Services &amp; Tasks" />
                                <TextBlock FontWeight="Bold" Style="{ThemeResource TitleMediumTextBlockStyle}" Text="{x:Bind ViewModel.SelectedSavedSession.CreatedServices.Count, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Detailed Lists -->
                    <TabView Grid.Row="2">
                        <TabViewItem Header="Created Files &amp; Folders" IsClosable="False">
                            <ListView ItemsSource="{x:Bind ViewModel.SelectedSavedSession.CreatedFiles, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            Padding="0,4"
                                            Text="{x:Bind}"
                                            TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </TabViewItem>

                        <TabViewItem Header="Created Registry Keys" IsClosable="False">
                            <ListView ItemsSource="{x:Bind ViewModel.SelectedSavedSession.CreatedRegistryKeys, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            Padding="0,4"
                                            Text="{x:Bind}"
                                            TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </TabViewItem>
                    </TabView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
