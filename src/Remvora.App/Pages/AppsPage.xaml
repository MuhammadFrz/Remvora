<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Name="RootPage"
    x:Class="Remvora.App.Pages.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Remvora.App.ViewModels"
    xmlns:proc="using:Remvora.Application.Processes"
    mc:Ignorable="d">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical" Spacing="4">
                <TextBlock Text="Installed Applications" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
                <TextBlock Text="Safe, evidence-based software uninstallation and residual cleanup engine." Style="{ThemeResource BodySubtleTextBlockStyle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Command="{x:Bind ViewModel.RefreshCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;"/>
                        <TextBlock Text="Refresh Inventory"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Search and Filter Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search -->
            <TextBox
                PlaceholderText="Search by name or publisher..."
                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            </TextBox>

            <!-- Category Filter Tabs -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0">
                <RadioButtons SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" MaxColumns="4">
                    <x:String>All</x:String>
                    <x:String>Desktop</x:String>
                    <x:String>Store</x:String>
                    <x:String>Large</x:String>
                </RadioButtons>
            </StackPanel>

            <!-- Sort By -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Sort by:" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}"/>
                <ComboBox SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}" Width="130">
                    <x:String>Name</x:String>
                    <x:String>Publisher</x:String>
                    <x:String>Size</x:String>
                    <x:String>Date</x:String>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Main Content (List + Details Pane) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="380" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <!-- Applications Virtualized List -->
            <ListView
                ItemsSource="{x:Bind ViewModel.FilteredApplications, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ApplicationItemViewModel">
                        <Grid Padding="8,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Complete Uninstall" Command="{Binding ElementName=RootPage, Path=ViewModel.StartCompleteUninstallCommand}" CommandParameter="{x:Bind}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Forced Uninstall" Command="{Binding ElementName=RootPage, Path=ViewModel.StartForcedUninstallCommand}" CommandParameter="{x:Bind}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE894;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Standard Uninstall" Command="{Binding ElementName=RootPage, Path=ViewModel.StartStandardUninstallCommand}" CommandParameter="{x:Bind}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE71A;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="Open Install Location" Command="{Binding ElementName=RootPage, Path=ViewModel.OpenInstallLocationCommand}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xED25;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <!-- App Avatar Initials -->
                            <Border
                                Width="36" Height="36"
                                CornerRadius="18"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind Initials}"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Name and Publisher -->
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Publisher}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="•" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Text="{x:Bind DisplayVersion}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Badges (Size & Type) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{x:Bind ScopeDescription}" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                </Border>
                                <TextBlock Text="{x:Bind FormattedSize}" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="60" TextAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Splitter Separator -->
            <Border Grid.Column="1" Width="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="12,0"/>

            <!-- Details Side Pane -->
            <ScrollViewer Grid.Column="2">
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.SelectedItem, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Visible}">
                        <!-- Details Header -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.SelectedItem.DisplayName, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind ViewModel.SelectedItem.Publisher, Mode=OneWay}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <!-- Primary Uninstall Actions Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Uninstallation Actions" Style="{ThemeResource BodyStrongTextBlockStyle}"/>

                                <!-- Complete Uninstall -->
                                <Button
                                    Command="{x:Bind ViewModel.StartCompleteUninstallCommand}"
                                    CommandParameter="{x:Null}"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE74D;" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Complete Uninstall" FontWeight="SemiBold"/>
                                            <TextBlock Text="Uninstaller + leftover scan &amp; safe removal" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.8"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Secondary Actions Row -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Forced Uninstall -->
                                    <Button
                                        Grid.Column="0"
                                        Command="{x:Bind ViewModel.StartForcedUninstallCommand}"
                                        CommandParameter="{x:Null}"
                                        HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE894;"/>
                                            <TextBlock Text="Forced"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Standard Uninstall -->
                                    <Button
                                        Grid.Column="1"
                                        Command="{x:Bind ViewModel.StartStandardUninstallCommand}"
                                        CommandParameter="{x:Null}"
                                        HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE71A;"/>
                                            <TextBlock Text="Standard"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Key Attributes Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <TextBlock Text="Version" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedItem.DisplayVersion, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="Medium"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Estimated Size" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedItem.FormattedSize, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="Medium"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Install Date" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedItem.FormattedInstallDate, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="Medium"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Architecture" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedItem.ArchitectureDescription, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="Medium"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Installer Type" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedItem.InstallerTypeDescription, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="Medium"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Location & Actions -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Install Location" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBox Text="{x:Bind ViewModel.SelectedItem.InstallLocation, Mode=OneWay}" IsReadOnly="True"/>
                            <Button Command="{x:Bind ViewModel.OpenInstallLocationCommand}" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xED25;"/>
                                    <TextBlock Text="Open in File Explorer"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- Inventory Loading Overlay -->
            <Border
                Grid.ColumnSpan="3"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Opacity="0.9"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="48" Height="48"/>
                    <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TotalSizeText, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>

        <!-- ======================================================== -->
        <!-- INTERACTIVE WORKFLOW MODAL OVERLAYS (PHASES 9 & 10)     -->
        <!-- ======================================================== -->
        <Grid
            Grid.RowSpan="4"
            Background="#70000000"
            Visibility="{x:Bind ViewModel.IsFlowActive, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">

            <!-- 1. Running Processes Warning Modal -->
            <Border
                Width="520"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24"
                Visibility="{x:Bind ViewModel.FlowStage, Mode=OneWay, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=ProcessesWarning}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE7BA;" FontSize="28" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Running Processes Detected" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                            <TextBlock Text="Active instances of this application are running." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="To prevent file lock conflicts during uninstallation, close these processes:" Style="{ThemeResource BodyTextBlockStyle}"/>

                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" MaxHeight="180" Padding="8">
                        <ListView ItemsSource="{x:Bind ViewModel.ActiveProcesses, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="proc:RunningProcessInfo">
                                    <Grid Padding="4,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE7F4;" FontSize="14" Margin="0,0,8,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind ProcessName}" FontWeight="Medium"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind ProcessId}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Cancel" Command="{x:Bind ViewModel.CancelFlowCommand}"/>
                        <Button Content="Ignore &amp; Continue" Command="{x:Bind ViewModel.IgnoreAndContinueCommand}"/>
                        <Button Content="Close Processes &amp; Continue" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.TerminateAndContinueCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 2. Workflow In-Progress Modal -->
            <Border
                Width="480"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="32"
                Visibility="{x:Bind ViewModel.FlowStage, Mode=OneWay, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=ExecutingWorkflow}">
                <StackPanel Spacing="20" HorizontalAlignment="Center">
                    <ProgressRing IsActive="True" Width="56" Height="56" HorizontalAlignment="Center"/>
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.FlowTitle, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" TextAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.FlowStatusMessage, Mode=OneWay}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" MaxWidth="400" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Content="Cancel" Command="{x:Bind ViewModel.CancelFlowCommand}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 3. Leftover Traces Review & Selection Modal -->
            <Border
                Width="820" MaxHeight="640"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24"
                Visibility="{x:Bind ViewModel.FlowStage, Mode=OneWay, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=ReviewingLeftovers}">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.FlowTitle, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold"/>
                            <TextBlock Text="Review identified residual items before permanent cleanup." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.CleanupPreview.ReclaimableSpaceText, Mode=OneWay}" Foreground="White" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <!-- Filter & Batch Selection Bar -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Filter Tabs -->
                        <RadioButtons SelectedItem="{x:Bind ViewModel.CleanupPreview.FilterKind, Mode=TwoWay}" MaxColumns="5">
                            <x:String>All</x:String>
                            <x:String>Files</x:String>
                            <x:String>Registry</x:String>
                            <x:String>Services</x:String>
                            <x:String>Shortcuts</x:String>
                        </RadioButtons>

                        <!-- Batch Selection Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Content="Recommended" Command="{x:Bind ViewModel.CleanupPreview.SelectRecommendedCommand}"/>
                            <Button Content="All" Command="{x:Bind ViewModel.CleanupPreview.SelectAllCommand}"/>
                            <Button Content="None" Command="{x:Bind ViewModel.CleanupPreview.DeselectAllCommand}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Candidates List -->
                    <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <ListView ItemsSource="{x:Bind ViewModel.CleanupPreview.FilteredCandidates, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:CandidateItemViewModel">
                                    <Grid Padding="8,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Selection Checkbox -->
                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanToggleSelection}"/>

                                        <!-- Kind Glyph -->
                                        <FontIcon Grid.Column="1" Glyph="{x:Bind KindGlyph}" FontSize="16" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                        <!-- Target Path & Evidence -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind Target}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind EvidenceSummary}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Confidence Badge -->
                                        <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ConfidenceText}" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                        </Border>

                                        <!-- Size -->
                                        <TextBlock Grid.Column="4" Text="{x:Bind SizeFormatted}" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="60" TextAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <!-- Bottom Action Bar -->
                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{x:Bind ViewModel.CleanupPreview.SelectedCandidatesCount, Mode=OneWay}" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="Cancel" Command="{x:Bind ViewModel.CancelFlowCommand}"/>
                            <Button Content="Skip Cleanup" Command="{x:Bind ViewModel.SkipCleanupCommand}"/>
                            <Button Content="Clean Up Selected Items" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.ConfirmCleanupCommand}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 4. Execution of Cleanup Modal -->
            <Border
                Width="480"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="32"
                Visibility="{x:Bind ViewModel.FlowStage, Mode=OneWay, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=ExecutingCleanup}">
                <StackPanel Spacing="20" HorizontalAlignment="Center">
                    <ProgressRing IsActive="True" Width="56" Height="56" HorizontalAlignment="Center"/>
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.FlowTitle, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" TextAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.FlowStatusMessage, Mode=OneWay}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" MaxWidth="400" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 5. Completed Summary Modal -->
            <Border
                Width="500"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="28"
                Visibility="{x:Bind ViewModel.FlowStage, Mode=OneWay, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=CompletedSummary}">
                <StackPanel Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Border Width="48" Height="48" CornerRadius="24" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE73E;" FontSize="24" Foreground="{ThemeResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.SummaryTitle, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold"/>
                            <TextBlock Text="Operation finished." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{x:Bind ViewModel.SummaryDetails, Mode=OneWay}" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap"/>

                    <!-- Reboot Required InfoBar -->
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.RebootRequired, Mode=OneWay}"
                        Severity="Warning"
                        Title="System Restart Recommended"
                        Message="Some locked files or services are scheduled for removal on the next Windows reboot."
                        IsClosable="False"/>

                    <Grid Margin="0,12,0,0">
                        <Button
                            Content="Undo / Rollback Cleanup"
                            Command="{x:Bind ViewModel.RollbackLastTransactionCommand}"
                            Visibility="{x:Bind ViewModel.CanRollback, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <Button
                            Content="Done"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.CloseSummaryCommand}"
                            HorizontalAlignment="Right"
                            MinWidth="100"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
