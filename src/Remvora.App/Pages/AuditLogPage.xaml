<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Remvora.App.Pages.AuditLogPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Remvora.App.ViewModels"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid Padding="24" RowDefinitions="Auto,Auto,Auto,*">
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="4">
            <TextBlock
                FontWeight="SemiBold"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="Audit &amp; Activity Log" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource BodyTextBlockStyle}"
                Text="Evidence-based ledger of all uninstalls, elevated subprocess executions, filesystem and registry changes, and transaction states." />
        </StackPanel>

        <!-- Filter & Search Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,16" ColumnDefinitions="Auto,*,Auto,Auto">
            <SelectorBar
                x:Name="CategorySelectorBar"
                Grid.Column="0"
                Margin="0,0,16,0"
                Loaded="CategorySelectorBar_Loaded"
                SelectionChanged="CategorySelectorBar_SelectionChanged">
                <SelectorBarItem x:Name="AllEventsItem" Text="All Events" />
                <SelectorBarItem Text="Modifications" />
                <SelectorBarItem Text="Transactions &amp; Rollback" />
                <SelectorBarItem Text="Elevation &amp; Subprocess" />
                <SelectorBarItem Text="Warnings &amp; Errors" />
            </SelectorBar>

            <AutoSuggestBox
                Grid.Column="2"
                Width="260"
                Margin="0,0,8,0"
                PlaceholderText="Filter audit events..."
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Button
                Grid.Column="3"
                Command="{x:Bind ViewModel.LoadEventsCommand}"
                ToolTipService.ToolTip="Refresh Audit Log">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
            </Button>
        </Grid>

        <!-- Status InfoBar & Progress -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12" Spacing="8">
            <InfoBar
                IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" />
            <ProgressBar
                IsIndeterminate="True"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <!-- Audit Events List -->
        <Border
            Grid.Row="3"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <ListView
                ItemsSource="{x:Bind ViewModel.FilteredEvents, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AuditEventItemViewModel">
                        <Border
                            Padding="12,10"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <!-- Severity / Category Icon -->
                                <Border
                                    Grid.Column="0"
                                    Width="36"
                                    Height="36"
                                    Margin="0,0,12,0"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="6">
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                        Glyph="&#xE81C;" />
                                </Border>

                                <!-- Event Details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Action}" />
                                        <Border
                                            Padding="6,1"
                                            Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                            CornerRadius="4">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Text="{x:Bind Category}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Target path / detail -->
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Target}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{x:Bind Target, Converter={StaticResource NullToVisibilityConverter}}" />

                                    <!-- Extra details if present -->
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Details}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind Details, Converter={StaticResource NullToVisibilityConverter}}" />
                                </StackPanel>

                                <!-- Timestamp & Result Badge -->
                                <StackPanel
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Spacing="4">
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind FormattedTimestamp}" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Result}"
                                        Visibility="{x:Bind Result, Converter={StaticResource NullToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
