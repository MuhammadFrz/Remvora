<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Remvora.App.Pages.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Remvora.App.ViewModels"
    mc:Ignorable="d">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical" Spacing="4">
                <TextBlock Text="Installed Applications" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
                <TextBlock Text="Discover, manage, and inspect installed software and packaged components." Style="{ThemeResource BodySubtleTextBlockStyle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Command="{x:Bind ViewModel.RefreshCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;"/>
                        <TextBlock Text="Refresh Inventory"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Search and Filter Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search -->
            <TextBox
                PlaceholderText="Search by name or publisher..."
                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            </TextBox>

            <!-- Category Filter Tabs -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0">
                <RadioButtons SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" MaxColumns="4">
                    <x:String>All</x:String>
                    <x:String>Desktop</x:String>
                    <x:String>Store</x:String>
                    <x:String>Large</x:String>
                </RadioButtons>
            </StackPanel>

            <!-- Sort By -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Sort by:" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}"/>
                <ComboBox SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}" Width="130">
                    <x:String>Name</x:String>
                    <x:String>Publisher</x:String>
                    <x:String>Size</x:String>
                    <x:String>Date</x:String>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Main Content (List + Details Pane) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="380" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Applications Virtualized List -->
            <ListView
                ItemsSource="{x:Bind ViewModel.FilteredApplications, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ApplicationItemViewModel">
                        <Grid Padding="8,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- App Avatar Initials -->
                            <Border
                                Width="36" Height="36"
                                CornerRadius="18"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind Initials}"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Name and Publisher -->
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Publisher}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="•" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Text="{x:Bind DisplayVersion}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Badges (Size & Type) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{x:Bind ScopeDescription}" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                </Border>
                                <TextBlock Text="{x:Bind FormattedSize}" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="60" TextAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Splitter Separator -->
            <Border Grid.Column="1" Width="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="12,0"/>

            <!-- Details Side Pane -->
            <ScrollViewer Grid.Column="2">
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.SelectedItem, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Visible}">
                        <!-- Details Header -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.SelectedItem.DisplayName, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind ViewModel.SelectedItem.Publisher, Mode=OneWay}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <!-- Key Attributes Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <TextBlock Text="Version" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedItem.DisplayVersion, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="Medium"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Estimated Size" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedItem.FormattedSize, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="Medium"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Install Date" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedItem.FormattedInstallDate, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="Medium"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Architecture" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedItem.ArchitectureDescription, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="Medium"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Installer Type" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedItem.InstallerTypeDescription, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="Medium"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Location & Actions -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Install Location" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBox Text="{x:Bind ViewModel.SelectedItem.InstallLocation, Mode=OneWay}" IsReadOnly="True"/>
                            <Button Command="{x:Bind ViewModel.OpenInstallLocationCommand}" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xED25;"/>
                                    <TextBlock Text="Open in File Explorer"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Uninstall Commands Info -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Uninstall Metadata" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <Grid>
                                <TextBlock Text="Standard Uninstall" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedItem.CanUninstall, Mode=OneWay}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Quiet Uninstall" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedItem.CanQuietUninstall, Mode=OneWay}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- Loading Progress Overlay -->
            <Border
                Grid.ColumnSpan="3"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Opacity="0.9"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="48" Height="48"/>
                    <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TotalSizeText, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>
    </Grid>
</Page>
